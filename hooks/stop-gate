#!/usr/bin/env bash
# Stop hook for the dsx plugin.
#
# Refuses to let the session end while any ANALYSIS-SPEC under the working
# directory fails `dsx audit`. This is the same gate GSD ran at ship:pre, moved
# to the one point every harness has: the end of the turn.
#
#   exit 0  allow the stop
#   exit 2  block it; stderr is handed back to the model as the reason
#
# Contract with dsx itself: audit exit 0 = pass, 1 = blocked, 2 = could not run.
# Both 1 and 2 block here — a gate that could not run has verified nothing.
#
# Environment:
#   DSX_STOP_GATE=off     disable for this shell (mirrors dsx.enforce on GSD)
#   DSX_BLOCK_ON=HIGH     minimum severity that blocks (CRITICAL|HIGH|MEDIUM|LOW)
#   DSX_SEARCH_DEPTH=4    how deep under cwd to look for specs
#   DSX_PYTHON=<path>     interpreter override (default: python3, then python;
#                         whichever is used must be Python >= 3.9)

set -uo pipefail

case "${DSX_STOP_GATE:-on}" in
  off|0|false|no) exit 0 ;;
esac

input="$(cat 2>/dev/null || true)"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"

# The payload carries cwd and stop_hook_active. When the hook has already
# blocked this stop once, Claude Code sets stop_hook_active; blocking again
# would loop forever, so let it through. This first read is deliberately
# python-free (grep on the raw JSON): the loop-breaker must work even on a
# machine with no usable interpreter, or a missing python blocks forever.
# The leading [^\\] keeps an escaped copy of the key inside some string value
# from matching.
if printf '%s' "$input" | grep -Eq '(^|[^\\])"stop_hook_active"[[:space:]]*:[[:space:]]*true'; then
  exit 0
fi

# Python 3.9+ only, like install.mjs findPython(): a Python 2 `python` on PATH
# must not satisfy the probe and then fail inside dsx. DSX_PYTHON is tried
# first; if it does not pass the probe the usual candidates are tried next.
py_ok() {
  command -v "$1" >/dev/null 2>&1 &&
    "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1
}
PY=""
for candidate in "${DSX_PYTHON:-}" python3 python; do
  if [ -n "$candidate" ] && py_ok "$candidate"; then PY="$candidate"; break; fi
done

active=0
cwd=""
if [ -n "$PY" ]; then
  parsed="$("$PY" -c '
import json, sys
try:
    d = json.loads(sys.argv[1] or "{}")
except Exception:
    d = {}
if not isinstance(d, dict):
    d = {}
# Write bytes: text-mode stdout turns every \n into \r\n on Windows, and the
# shell below would then compare "1\r" against "1" and never take the early exit.
sys.stdout.buffer.write((("1" if d.get("stop_hook_active") else "0")
                         + "\n" + (d.get("cwd") or "") + "\n").encode())
' "$input")"
  active="${parsed%%$'\n'*}"
  cwd="${parsed#*$'\n'}"
  cwd="${cwd%$'\n'}"
else
  # No interpreter: pull cwd out with sed so the spec search below still looks
  # in the right place. Only the escapes a path can carry are undone.
  cwd="$(printf '%s' "$input" \
    | sed -nE 's/.*(^|[^\\])"cwd"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)".*/\2/p' \
    | head -n 1 \
    | sed -e 's#\\/#/#g' -e 's#\\"#"#g' -e 's#\\\\#\\#g')"
fi
if [ "$active" = "1" ]; then
  exit 0
fi
if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
  cwd="$PWD"
fi

run_dsx() {
  if [ -f "$PLUGIN_ROOT/dsx/__main__.py" ]; then
    PYTHONPATH="$PLUGIN_ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PY" -m dsx "$@"
  elif command -v dsx >/dev/null 2>&1; then
    dsx "$@"
  else
    echo "dsx stop-gate: cannot find the dsx package (looked in $PLUGIN_ROOT and PATH)." >&2
    return 2
  fi
}

depth="${DSX_SEARCH_DEPTH:-4}"
specs="$(find "$cwd" -maxdepth "$depth" \
  \( -name .git -o -name node_modules -o -name .venv -o -name __pycache__ \) -prune -o \
  \( -name 'ANALYSIS-SPEC.yaml' -o -name 'ANALYSIS-SPEC.yml' -o -name 'ANALYSIS-SPEC.json' \) -type f -print 2>/dev/null | sort)"

# No spec, nothing to gate. Safe in a mixed repository — and this holds even
# without python, which is only required from here on.
if [ -z "$specs" ]; then
  exit 0
fi

if [ -z "$PY" ]; then
  {
    echo "dsx stop-gate: found ANALYSIS-SPEC file(s) but no Python 3.9+ interpreter (tried ${DSX_PYTHON:+$DSX_PYTHON, }python3, python)."
    echo "Nothing was verified. Install Python 3.9+ or point DSX_PYTHON at one, or set DSX_STOP_GATE=off to disable the gate."
    echo "$specs"
  } >&2
  exit 2
fi

block_on="${DSX_BLOCK_ON:-HIGH}"
blocked=0
broken=0
passed=0
report=""

IFS=$'\n'
for spec in $specs; do
  out="$(run_dsx audit --spec "$spec" --block-on "$block_on" 2>&1)"
  code=$?
  case "$code" in
    0) passed=$((passed + 1)) ;;
    1) blocked=$((blocked + 1))
       report="${report}"$'\n'"── BLOCKED: ${spec}"$'\n'"${out}"$'\n' ;;
    *) broken=$((broken + 1))
       report="${report}"$'\n'"── COULD NOT RUN (exit ${code}): ${spec}"$'\n'"${out}"$'\n' ;;
  esac
done
unset IFS

if [ "$blocked" -gt 0 ] || [ "$broken" -gt 0 ]; then
  {
    echo "dsx stop-gate: ${blocked} spec(s) blocked, ${broken} could not be checked, ${passed} passed (block_on=${block_on})."
    echo "Fix the spec or the analysis, then finish again. Do not reword the claim around a finding."
    echo "${report}"
  } >&2
  exit 2
fi

echo "dsx stop-gate: ${passed} ANALYSIS-SPEC(s) pass at ${block_on}."
exit 0
